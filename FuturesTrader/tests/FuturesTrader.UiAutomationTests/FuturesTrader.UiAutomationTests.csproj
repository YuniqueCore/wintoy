<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Host exe 是 x64（CTP 6.7.13 64位 DLL），FlaUI 进程必须与目标同架构 -->
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- UI 自动化测试需要 STA 线程操作 WPF UI 元素 -->
    <XunitRunnerPreferredThreads>STA</XunitRunnerPreferredThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 不引用 Host/Presentation 项目：UI 自动化测试是端到端黑盒，通过 Process.Start 启动真实 exe，用 FlaUI 操作 UI -->
  <!-- Host exe 路径通过 MSBuild 属性解析，测试运行时用相对路径定位 -->

  <Target Name="PrintHostPath" BeforeTargets="Build">
    <PropertyGroup>
      <HostExePath>$(MSBuildThisFileDirectory)..\..\src\FuturesTrader.Host\bin\$(Configuration)\net10.0-windows\FuturesTrader.Host.exe</HostExePath>
    </PropertyGroup>
    <Message Text="HostExePath=$(HostExePath)" Importance="high" />
  </Target>

</Project>
