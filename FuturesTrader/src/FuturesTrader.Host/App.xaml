<Application x:Class="FuturesTrader.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:FuturesTrader.Presentation.Converters;assembly=FuturesTrader.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局转换器：供 FloatingMainWindow/TradingWindow/SettingsWindow 等所有窗口以 {StaticResource} 引用 -->
            <conv:EnumToBoolConverter x:Key="EnumToBool"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:LatencyToBrushConverter x:Key="LatencyToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
