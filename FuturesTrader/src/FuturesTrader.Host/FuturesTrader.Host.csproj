<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- CTP 6.7.13 原生 DLL（64 位 x64）：v6.7.13 提供 64 位版，优先使用 64 位进程 -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuturesTrader.Mcp\FuturesTrader.Mcp.csproj" />
    <ProjectReference Include="..\FuturesTrader.Presentation\FuturesTrader.Presentation.csproj" />
    <ProjectReference Include="..\FuturesTrader.Application\FuturesTrader.Application.csproj" />
    <ProjectReference Include="..\FuturesTrader.Infrastructure\FuturesTrader.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- CTP 6.7.13 原生行情 DLL（64 位 x64）：P/Invoke 按 DLL 名在 exe 同目录解析，必须平铺到输出根 -->
    <None Include="native\thostmduserapi_se.dll"
          Link="thostmduserapi_se.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <!-- CTP 6.7.13 原生交易 DLL（64 位 x64）：CtpTradingService 通过 ThostTraderApiNative P/Invoke 调用 -->
    <None Include="native\thosttraderapi_se.dll"
          Link="thosttraderapi_se.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />

    <!-- 自包含配置/数据文件：复制到输出目录 data\ 子目录，appsettings.json 用相对路径引用 -->
    <None Include="data\config.ini"      Link="data\config.ini"      CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\Users.xml"       Link="data\Users.xml"       CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\HQAddress.xml"   Link="data\HQAddress.xml"   CopyToOutputDirectory="PreserveNewest" />

    <!-- 自包含音效文件：复制到输出目录 assets\sounds\ 子目录，SoundOptions.BasePath 指向该目录 -->
    <None Include="assets\sounds\*.wav"  Link="assets\sounds\%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
