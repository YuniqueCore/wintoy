<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- CTP thostmduserapi_se.dll 是 32 位，进程必须 x86 -->
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuturesTrader.Mcp\FuturesTrader.Mcp.csproj" />
    <ProjectReference Include="..\FuturesTrader.Presentation\FuturesTrader.Presentation.csproj" />
    <ProjectReference Include="..\FuturesTrader.Application\FuturesTrader.Application.csproj" />
    <ProjectReference Include="..\FuturesTrader.Infrastructure\FuturesTrader.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- CTP 6.7.11 原生行情 DLL（32 位 x86）：P/Invoke 在运行时按 DLL 名解析，必须与 exe 同目录或在 PATH -->
    <None Include="D:\work\projs\futures\qihuo-software\thostmduserapi_se.dll"
          Link="thostmduserapi_se.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <!-- CTP 6.7.11 原生交易 DLL（32 位 x86）：CtpTradingService 通过 ThostTraderApiNative P/Invoke 调用 -->
    <None Include="D:\work\projs\futures\qihuo-software\thosttraderapi_se.dll"
          Link="thosttraderapi_se.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
