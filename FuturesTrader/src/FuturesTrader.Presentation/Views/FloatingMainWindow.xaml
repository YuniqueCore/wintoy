<Window x:Class="FuturesTrader.Presentation.Views.FloatingMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FuturesTrader.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FloatingMainViewModel}"
        Title="浮动工具栏"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AllowsTransparency="False"
        MinWidth="600" MinHeight="80" Width="1100" Height="96">
    <Window.Resources>
        <!-- 分组按钮样式：紧凑方块，选中高亮 -->
        <Style x:Key="GroupButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Content" Value="{Binding Id}"/>
            <Setter Property="Command" Value="{Binding OpenCommand}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowCount}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 互斥切换按钮样式（单/多/全部 · 仓/平 · A/B） -->
        <Style x:Key="SegmentButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="0"
            MouseLeftButtonDown="OnDragMove">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行：账号 | 分组1-10 | 单/多/全部 | 模式 | 两排 | 搜索 -->
            <DockPanel Grid.Row="0" Margin="6,3">
                <!-- 账号 ID（洋红色强调） -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                    <TextBlock Text="{Binding AccountId}" FontWeight="Bold"
                               Foreground="#FFC060FF" VerticalAlignment="Center"/>
                </Border>

                <!-- 右侧功能按钮组 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- 单/多/全部 互斥分段 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="单" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=Single, Mode=TwoWay}"/>
                            <RadioButton Content="多" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=Multi, Mode=TwoWay}"/>
                            <RadioButton Content="全部" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=All, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <ui:Button Content="模式" Padding="8,3" Margin="4,0,0,0"/>
                    <ui:Button Content="两排" Padding="8,3" Margin="2,0,0,0"/>
                    <!-- 合约搜索 -->
                    <ui:TextBox PlaceholderText="搜索合约..." Width="140" Margin="8,0,0,0"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 中间：分组 1-10 -->
                <ItemsControl ItemsSource="{Binding GroupsRow1}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GroupButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- 第二行：日 | 分组11-20 | 切组/撤组/标尺/白格 | 仓/平 | A/B | 同步开关 -->
            <DockPanel Grid.Row="1" Margin="6,1">
                <!-- 左侧日计数占位 -->
                <TextBlock DockPanel.Dock="Left" Text="日:0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>

                <!-- 右侧操作组 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:Button Content="切组" Padding="8,3"/>
                    <ui:Button Content="撤组" Padding="8,3" Margin="2,0,0,0"/>
                    <CheckBox Content="标尺" IsChecked="{Binding ShowRuler}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="白格" IsChecked="{Binding ShowWhiteGrid}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <!-- 仓/平 互斥 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="仓" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding OrderMode, Converter={StaticResource EnumToBool}, ConverterParameter=Open, Mode=TwoWay}"/>
                            <RadioButton Content="平" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding OrderMode, Converter={StaticResource EnumToBool}, ConverterParameter=Close, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <!-- A/B 互斥 -->
                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="A" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding AbMode, Converter={StaticResource EnumToBool}, ConverterParameter=A, Mode=TwoWay}"/>
                            <RadioButton Content="B" Style="{StaticResource SegmentButtonStyle}"
                                         IsChecked="{Binding AbMode, Converter={StaticResource EnumToBool}, ConverterParameter=B, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 中间：分组 11-20 -->
                <ItemsControl ItemsSource="{Binding GroupsRow2}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GroupButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- 第三行：资金摘要（红色文字）+ 右侧系统按钮 -->
            <DockPanel Grid.Row="2" Margin="6,2">
                <!-- 右侧系统按钮：置顶/同步/设置/最小化/关闭/登出 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="TopmostButton" Icon="{ui:SymbolIcon Pin24}" ToolTip="切换置顶"
                               Command="{Binding ToggleTopmostCommand}" Padding="6,3"/>
                    <ui:Button Icon="{ui:SymbolIcon Link24}" ToolTip="切换窗口同步（成组/独立）"
                               Command="{Binding ToggleSyncModeCommand}" Padding="6,3" Margin="2,0,0,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Settings24}" ToolTip="设置"
                               Command="{Binding OpenSettingsCommand}" Padding="6,3" Margin="2,0,0,0"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowMinimize24}" ToolTip="最小化"
                               Click="OnMinimize" Padding="6,3" Margin="2,0,0,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="关闭浮动栏（登出）"
                               Click="OnClose" Padding="6,3" Margin="2,0,0,0"
                               Appearance="Danger"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowExit20}" ToolTip="登出"
                               Command="{Binding LogoutCommand}" Padding="6,3" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- 资金摘要：市/净/可/持/权/手（红色等宽） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="市:" Foreground="#FFFF4040" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.MarketValue, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="#FFFF4040" FontFamily="Consolas" MinWidth="60" Margin="0,0,12,0"/>
                    <TextBlock Text="净:" Foreground="#FFFF4040" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.NetProfit, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="#FFFF4040" FontFamily="Consolas" MinWidth="40" Margin="0,0,12,0"/>
                    <TextBlock Text="可:" Foreground="#FFFF4040" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.Available, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="#FFFF4040" FontFamily="Consolas" MinWidth="60" Margin="0,0,12,0"/>
                    <TextBlock Text="持:" Foreground="#FFFF4040" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.PositionLots, StringFormat=N0, TargetNullValue='0'}"
                               Foreground="#FFFF4040" FontFamily="Consolas" MinWidth="30" Margin="0,0,12,0"/>
                    <TextBlock Text="权:" Foreground="#FFFF4040" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.Equity, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="#FFFF4040" FontFamily="Consolas" MinWidth="60" Margin="0,0,12,0"/>
                    <TextBlock Text="手:" Foreground="#FFFF4040" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.TradeLots, StringFormat=N0, TargetNullValue='0'}"
                               Foreground="#FFFF4040" FontFamily="Consolas" MinWidth="30"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
