<Window x:Class="FuturesTrader.Presentation.Views.FloatingMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FuturesTrader.Presentation.ViewModels"
        xmlns:controls="clr-namespace:FuturesTrader.Presentation.Controls"
        AutomationProperties.AutomationId="FloatingMainWindow"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FloatingMainViewModel}"
        Title="浮动工具栏"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AllowsTransparency="False"
        MinWidth="600" MinHeight="130" Width="1100" Height="145">
    <Window.Resources>
        <!-- 分组按钮样式：紧凑方块，选中高亮 -->
        <Style x:Key="GroupButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Content" Value="{Binding Id}"/>
            <Setter Property="Command" Value="{Binding OpenCommand}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowCount}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0：拖动手柄（专用区域，含可见 grip 提示） -->
                <RowDefinition Height="22"/>
                <!-- Row 1：账号 | 分组1-10 | 单/多/全部 | 模式 | 两排 | 搜索 -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2：日 | 分组11-20 | 切组/撤组/标尺/白格 | 仓/平 | A/B | 同步开关 -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3：资金摘要 + 右侧系统按钮 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0：拖动手柄（专用区域 + 可见 grip 横条）
                 只在此区域响应 MouseLeftButtonDown 拖动窗体，避免下方按钮区误触。
                 视觉提示：背景比主体略深 + 居中横条（8x40）说明可拖动。
                 Cursor 设为 SizeAll 提供指针语义反馈。 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="OnDragMove"
                    ToolTip="按住此处拖动窗口">
                <Grid>
                    <!-- 居中横条 grip：8:40 比例暗示「可拖动」语义，颜色用次要前景保持低调 -->
                    <Rectangle Width="40" Height="3"
                               RadiusX="1.5" RadiusY="1.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Fill="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Border>

            <!-- 第一行：账号 | 分组1-10 | 单/多/全部 | 模式 | 两排 | 搜索 -->
            <DockPanel Grid.Row="1" Margin="6,3">
                <!-- 账号 ID（洋红色强调） -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                    <TextBlock Text="{Binding AccountId}" FontWeight="Bold"
                               Foreground="#FFC060FF" VerticalAlignment="Center"/>
                </Border>

                <!-- 右侧功能按钮组 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- 单/多/全部 互斥分段 -->
                    <controls:SegmentedControl x:Name="DisplayModeSwitcher"
                                               ItemsSource="{Binding DisplayModeOptions}"
                                               SelectedValue="{Binding DisplayMode, Mode=TwoWay}"
                                               ValueSelector="Value"
                                               LabelSelector="Label"/>
                    <ui:Button Content="模式" Padding="8,3" Margin="4,0,0,0"/>
                    <ui:Button Content="两排" Padding="8,3" Margin="2,0,0,0"/>
                    <!-- 合约搜索 autocomplete：输入代码/名称 → 过滤下拉 → 选中添加到当前分组 -->
                    <Grid Margin="8,0,0,0" Width="180">
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="搜索合约..."
                                    AutomationProperties.AutomationId="InstrumentSearchBox"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Popup x:Name="SearchPopup"
                               IsOpen="{Binding IsSearchPopupOpen}"
                               Placement="Custom"
                               PlacementTarget="{Binding ElementName=SearchBox}"
                               StaysOpen="False"
                               Width="460" MaxHeight="360">
                            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="2">
                                <ListBox x:Name="SearchResultsList"
                                         AutomationProperties.AutomationId="InstrumentSearchResults"
                                         ItemsSource="{Binding FilteredInstruments}"
                                         SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,0.5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                                               AutomationProperties.AutomationId="InstrumentResultName"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,1"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstrumentId}"
                                                               AutomationProperties.AutomationId="InstrumentResultCode"
                                                               FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="10"
                                                               AutomationProperties.AutomationId="InstrumentResultDetails"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="交易所 "/><Run Text="{Binding ExchangeId}" FontWeight="SemiBold"/>
                                                        <Run Text="   最小变动 "/><Run Text="{Binding PriceTick, StringFormat={}{0:0.####}}"/>
                                                        <Run Text="   乘数 "/><Run Text="{Binding VolumeMultiple}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="10"
                                                               AutomationProperties.AutomationId="InstrumentResultLimits"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="限价手数 "/><Run Text="{Binding MinLimitOrderVolume}"/>
                                                        <Run Text=" - "/><Run Text="{Binding MaxLimitOrderVolume}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- 中间：分组 1-10 -->
                <ItemsControl ItemsSource="{Binding GroupsRow1}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GroupButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- 第二行：日 | 分组11-20 | 切组/撤组/标尺/白格 | 仓/平 | A/B | 同步开关 -->
            <DockPanel Grid.Row="2" Margin="6,1">
                <!-- 左侧日计数占位 -->
                <TextBlock DockPanel.Dock="Left" Text="日:0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>

                <!-- 右侧操作组 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:Button Content="切组" Padding="8,3"/>
                    <ui:Button Content="撤组" Padding="8,3" Margin="2,0,0,0"/>
                    <CheckBox Content="标尺" IsChecked="{Binding ShowRuler}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowWhiteGridToggle" Content="白格"
                              IsChecked="{Binding ShowWhiteGrid}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <!-- 仓/平 互斥分段 -->
                    <controls:SegmentedControl x:Name="OrderModeSwitcher"
                                               ItemsSource="{Binding OrderModeOptions}"
                                               SelectedValue="{Binding OrderMode, Mode=TwoWay}"
                                               ValueSelector="Value"
                                               LabelSelector="Label"
                                               Margin="8,0,0,0"/>
                    <!-- A/B 互斥分段 -->
                    <controls:SegmentedControl x:Name="AbModeSwitcher"
                                               ItemsSource="{Binding AbModeOptions}"
                                               SelectedValue="{Binding AbMode, Mode=TwoWay}"
                                               ValueSelector="Value"
                                               LabelSelector="Label"
                                               Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 中间：分组 11-20 -->
                <ItemsControl ItemsSource="{Binding GroupsRow2}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GroupButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- 第三行：资金摘要（红色文字）+ 右侧系统按钮 -->
            <DockPanel Grid.Row="3" Margin="6,2">
                <!-- 右侧系统按钮：置顶/同步/设置/最小化/关闭/登出
                     置顶 + 同步：使用 StateToggleButton（ToggleButton + 状态样式），
                     OFF=透明，ON=Accent 填充+白字，对齐「switcher 开启/关闭都需要清晰反馈」。
                     设置/最小化/关闭/登出 仍为瞬态 Button（无持久状态）。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:StateToggleButton x:Name="TopmostToggle"
                                                IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                                Icon="{ui:SymbolIcon Pin24}"
                                                ToolTip="切换置顶"/>
                    <controls:StateToggleButton x:Name="SyncLinkToggle"
                                                IsChecked="{Binding IsSyncGrouped, Mode=TwoWay}"
                                                Icon="{ui:SymbolIcon Link24}"
                                                ToolTip="切换窗口同步（成组/独立）"
                                                Margin="2,0,0,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Settings24}" ToolTip="设置"
                               Command="{Binding OpenSettingsCommand}" Padding="6,3" Margin="2,0,0,0"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowMinimize24}" ToolTip="最小化"
                               Click="OnMinimize" Padding="6,3" Margin="2,0,0,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="退出程序"
                               Click="OnClose" Padding="6,3" Margin="2,0,0,0"
                               Appearance="Danger"/>
                    <ui:Button x:Name="LogoutButton" Icon="{ui:SymbolIcon ArrowExit20}" ToolTip="登出"
                               Command="{Binding LogoutCommand}" Padding="6,3" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- 资金摘要：市/净/可/持/权/手（红色等宽） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="市:" Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.MarketValue, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" MinWidth="60" Margin="0,0,12,0"/>
                    <TextBlock Text="净:" Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.NetProfit, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" MinWidth="40" Margin="0,0,12,0"/>
                    <TextBlock Text="可:" Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.Available, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" MinWidth="60" Margin="0,0,12,0"/>
                    <TextBlock Text="持:" Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.PositionLots, StringFormat=N0, TargetNullValue='0'}"
                               Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" MinWidth="30" Margin="0,0,12,0"/>
                    <TextBlock Text="权:" Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.Equity, StringFormat=N0, TargetNullValue='—'}"
                               Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" MinWidth="60" Margin="0,0,12,0"/>
                    <TextBlock Text="手:" Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding AccountSummary.TradeLots, StringFormat=N0, TargetNullValue='0'}"
                               Foreground="{DynamicResource AccountSummaryBrush}" FontFamily="Consolas" MinWidth="30"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
