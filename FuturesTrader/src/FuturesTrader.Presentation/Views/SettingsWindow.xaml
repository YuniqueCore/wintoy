<ui:FluentWindow x:Class="FuturesTrader.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FuturesTrader.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="FuturesTrader 设置"
        Width="960" Height="660"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        AutomationProperties.AutomationId="SettingsWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="FuturesTrader 设置">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 主体：左栏段落导航 + 右栏表单 -->
        <Grid Grid.Row="1" Margin="12,4,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：段落导航 ListBox -->
            <ui:Card Grid.Column="0" Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <ui:Card.Content>
                    <ListBox Background="Transparent"
                             BorderThickness="0"
                             SelectedIndex="{Binding CurrentSectionIndex, Mode=TwoWay}"
                             Padding="4">
                        <ListBoxItem Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WindowDevTools24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Window 段" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldTask24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Order 段" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="User 段" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TabDesktopMultiple24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="窗口分组" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ColorBackground24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="外观" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </ui:Card.Content>
            </ui:Card>

            <!-- 右栏：操作栏 + 段落表单 + 状态栏 -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 操作栏：加载/保存 + 保存反馈（窗口分组段和外观段隐藏） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentSectionIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:Button Content="加载配置" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding LoadCommand}" Margin="0,0,8,0" Padding="16,8"/>
                    <ui:Button Content="保存配置"
                               Icon="{ui:SymbolIcon ArrowUpload24}"
                               Command="{Binding SaveCommand}" Margin="0,0,16,0" Padding="16,8"/>
                    <TextBlock Text="{Binding LastSavedAt, StringFormat='已保存 {0:HH:mm:ss}', TargetNullValue='尚未保存'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- 段落表单：按 CurrentSegment 运行时类型选 DataTemplate -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <ContentControl Content="{Binding CurrentSegment}">
                        <ContentControl.Resources>
                            <!-- Window 段表单 -->
                            <DataTemplate DataType="{x:Type vm:WindowConfigViewModel}">
                                <StackPanel>
                                    <ui:CardControl Margin="0,0,0,8">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="Window 段 · 窗口外观与交互参数" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <ui:Card Padding="16" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="主字体 MainFont" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MainFont, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Text="紧凑度 CompactSpacing" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding CompactSpacing, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Text="字号偏移 FontSizeOffset" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="2" Grid.Column="1" Value="{Binding FontSizeOffset, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Text="价格边距 PriceListMargin" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="3" Grid.Column="1" Value="{Binding PriceListMargin, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="4" Text="标题栏减高 DecTitle" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="4" Grid.Column="1" Value="{Binding DecTitle, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="5" Text="对齐 Align" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="5" Grid.Column="1" Value="{Binding Align, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="6" Text="窄模式减宽 NarrowReduceLength" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="6" Grid.Column="1" Value="{Binding NarrowReduceLength, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="7" Text="滚轮加速 MouseWheelSpeed" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="7" Grid.Column="1" Value="{Binding MouseWheelSpeed, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="8" Text="Tick 行高 TickRowHeights" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="8" Grid.Column="1" Value="{Binding TickRowHeights, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="9" Text="合约窗口高度 InstrumentWindowHeights" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="9" Grid.Column="1" Value="{Binding InstrumentWindowHeights, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="10" Text="自动大小 AutoSize" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:ToggleSwitch Grid.Row="10" Grid.Column="1" IsChecked="{Binding AutoSize}" Margin="0,4"/>
                                        </Grid>
                                    </ui:Card>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Order 段表单 -->
                            <DataTemplate DataType="{x:Type vm:OrderConfigViewModel}">
                                <StackPanel>
                                    <ui:CardControl Margin="0,0,0,8">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="Order 段 · 交易风控参数" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <ui:Card Padding="16" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="商品撤单 Spck (SP)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding Spck}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Text="股指撤单 Gzck (GZ)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Gzck}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Text="本地风控 RiskOpen" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding RiskOpen}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Text="股指最大撤单 MaxCancelGZ" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="3" Grid.Column="1" Value="{Binding MaxCancelGz, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="4" Text="商品最大撤单 MaxCancelSP" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="4" Grid.Column="1" Value="{Binding MaxCancelSp, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="5" Text="期权最大撤单 MaxCancelQQ" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="5" Grid.Column="1" Value="{Binding MaxCancelQq, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="6" Text="最大报单数 MaxInputCount (0=不限)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="6" Grid.Column="1" Value="{Binding MaxInputCount, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="7" Text="最大持仓数 MaxPositionCount (0=不限)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="7" Grid.Column="1" Value="{Binding MaxPositionCount, Mode=TwoWay}" Margin="0,4"/>
                                        </Grid>
                                    </ui:Card>
                                </StackPanel>
                            </DataTemplate>

                            <!-- User 段表单 -->
                            <DataTemplate DataType="{x:Type vm:UserConfigViewModel}">
                                <StackPanel>
                                    <ui:CardControl Margin="0,0,0,8">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="User 段 · 行情/交易连接与开盘抢单" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <ui:Card Padding="16" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="行情服务器 HqAddress" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HqAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Text="QDP 标记" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding Qdp, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Text="运行模式 RunMode (0=正常)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="2" Grid.Column="1" Value="{Binding RunMode, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Text="云风控 CloudRiskOn" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding CloudRiskOn}" Margin="0,4"/>
                                            <TextBlock Grid.Row="4" Text="行情转发 HqffOn" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding HqffOn}" Margin="0,4"/>
                                            <TextBlock Grid.Row="5" Text="转发目标 IP HqffIp" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:TextBox Grid.Row="5" Grid.Column="1" Text="{Binding HqffIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                                            <TextBlock Grid.Row="6" Text="转发目标端口 HqffPort" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="6" Grid.Column="1" Value="{Binding HqffPort, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="7" Text="抢单频率 MOrderXSpeed (ms)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="7" Grid.Column="1" Value="{Binding MOrderXSpeed, Mode=TwoWay}" Margin="0,4"/>
                                            <TextBlock Grid.Row="8" Text="抢单持续 MOrderXStop (ms)" VerticalAlignment="Center" Margin="0,4"/>
                                            <ui:NumberBox Grid.Row="8" Grid.Column="1" Value="{Binding MOrderXStop, Mode=TwoWay}" Margin="0,4"/>
                                        </Grid>
                                    </ui:Card>
                                    <ui:Card Padding="16" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="开盘抢单触发时间点 MOrderTimes（只读，9 个）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding MOrderTimes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding StringFormat='#{0}'}" FontFamily="Consolas"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </DataTemplate>

                            <!-- 窗口分组段 -->
                            <DataTemplate DataType="{x:Type vm:WindowGroupBarViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ui:CardControl Grid.Row="0" Margin="0,0,0,8">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="窗口分组 · 20 组合约窗口的绑定/重命名/一键开组" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <ui:Button Content="加载分组" Appearance="Primary"
                                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   Command="{Binding LoadCommand}" Margin="0,0,8,0" Padding="16,8"/>
                                        <ui:Button Content="保存分组"
                                                   Icon="{ui:SymbolIcon ArrowUpload24}"
                                                   Command="{Binding SaveCommand}" Margin="0,0,16,0" Padding="16,8"/>
                                        <TextBlock Text="{Binding LastSavedAt, StringFormat='已保存 {0:HH:mm:ss}', TargetNullValue='尚未保存'}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <ui:Card Grid.Row="2" Padding="12" Margin="0,0,0,8">
                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:WindowGroupViewModel}">
                                                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Margin="0,0,6,6"
                                                            MinWidth="120">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="重命名"
                                                                          Command="{Binding PlacementTarget.DataContext.BeginRenameCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid Margin="10,6">
                                                            <ui:Button Command="{Binding OpenGroupCommand}"
                                                                       Background="Transparent" BorderThickness="0"
                                                                       HorizontalAlignment="Stretch"
                                                                       HorizontalContentAlignment="Left" Padding="0">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Windows.Count, StringFormat='{}{0} 个窗口'}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                </StackPanel>
                                                            </ui:Button>
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <ui:TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                                            MinWidth="90" Margin="0,0,4,0">
                                                                    <ui:TextBox.InputBindings>
                                                                        <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}"/>
                                                                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/>
                                                                    </ui:TextBox.InputBindings>
                                                                </ui:TextBox>
                                                                <ui:Button Icon="{ui:SymbolIcon Checkmark24}"
                                                                           Command="{Binding CommitRenameCommand}" Margin="0,0,4,0"/>
                                                                <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                                                                           Command="{Binding CancelRenameCommand}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:Card>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                                        <ui:TextBox Text="{Binding NewInstrumentCode, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="220" Margin="0,0,8,0" PlaceholderText="输入合约码，如 ag2608"/>
                                        <ui:Button Content="绑定到当前组" Command="{Binding AssignWindowCommand}"
                                                   Padding="14,8" Margin="0,0,12,0"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding SelectedGroup.Name, StringFormat='→ {0}'}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <ui:Card Grid.Row="4" Padding="12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold"
                                                       Text="{Binding SelectedGroup.Name, StringFormat='当前组：{0} 的窗口'}"/>
                                            <ListView ItemsSource="{Binding SelectedGroup.Windows}"
                                                      Background="Transparent" BorderThickness="0">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="合约码" Width="180"
                                                                        DisplayMemberBinding="{Binding InstrumentCode}"/>
                                                        <GridViewColumn Header="已开" Width="60"
                                                                        DisplayMemberBinding="{Binding IsOpen}"/>
                                                        <GridViewColumn Header="操作" Width="260">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:Button Content="聚焦" Command="{Binding FocusCommand}"
                                                                                   Margin="0,0,4,0" Padding="10,4"/>
                                                                        <ui:Button Content="关闭" Command="{Binding CloseCommand}"
                                                                                   Margin="0,0,4,0" Padding="10,4"/>
                                                                        <ui:Button Content="解绑" Command="{Binding UnassignCommand}"
                                                                                   Padding="10,4"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </DockPanel>
                                    </ui:Card>
                                </Grid>
                            </DataTemplate>

                            <!-- 外观段：主题切换 -->
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <StackPanel>
                                    <ui:CardControl Margin="0,0,0,8">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="外观 · 主题与视觉" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <ui:Card Padding="16" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="主题" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="深色 (Dark)" GroupName="Theme"
                                                             IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                                             Margin="0,0,24,0" Padding="4,0"/>
                                                <RadioButton Content="浅色 (Light)" GroupName="Theme"
                                                             IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                                             Padding="4,0"/>
                                            </StackPanel>
                                            <TextBlock Text="主题切换即时生效，并持久化到 user-settings.json（下次启动自动应用）。"
                                                       FontSize="11" Margin="0,12,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>

                <!-- 状态栏（窗口分组段和外观段隐藏） -->
                <ContentControl Grid.Row="2" Content="{Binding State}" Margin="0,8,0,0">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentSectionIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ConfigEditorState+Idle}">
                            <TextBlock Text="● 未加载" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigEditorState+Loading}">
                            <TextBlock Text="● 正在加载..." Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigEditorState+Loaded}">
                            <TextBlock Text="● 已加载，可编辑" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigEditorState+Saving}">
                            <TextBlock Text="● 正在保存..." Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigEditorState+Error}">
                            <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
