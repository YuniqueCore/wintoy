<ui:FluentWindow x:Class="FuturesTrader.Presentation.Views.TradingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:FuturesTrader.Presentation.Controls"
                 xmlns:vm="clr-namespace:FuturesTrader.Presentation.ViewModels"
                 AutomationProperties.AutomationId="TradingWindow"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:TradingViewModel}"
                 Title="{Binding InstrumentDisplayName}"
                 Width="360" Height="780"
                 MinWidth="320" MinHeight="540"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 KeyDown="OnWindowKeyDown">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- 卡片 hover 样式：覆盖全窗口所有 ui:Card，鼠标移上去时背景切换到 CardHoverBackgroundBrush
             （DynamicResource 跟随主题），前景色不变以保证可读性。
             BasedOn 默认 WPF UI 卡片样式以保留圆角/阴影等外观。 -->
        <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
            <Setter Property="SpinButtonPlacementMode" Value="Compact"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 内部标题栏优先完整表达合约身份；系统窗口 Title 使用同一个绑定。 -->
        <ui:TitleBar Grid.Row="0"
                     AutomationProperties.AutomationId="ContractTitleBar"
                     AutomationProperties.Name="{Binding InstrumentDisplayName}">
            <ui:TitleBar.Header>
                <TextBlock Text="{Binding InstrumentDisplayName}"
                           AutomationProperties.AutomationId="ContractTitleText"
                           AutomationProperties.Name="{Binding InstrumentDisplayName}"
                           FontSize="12" FontWeight="SemiBold" LineHeight="16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding InstrumentDisplayName}"
                           MaxWidth="220" MaxHeight="34" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 主体：工具栏在 148-220 DIPs 内响应式伸缩，价格梯占剩余空间。 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="148" MaxWidth="220"/>
                <ColumnDefinition Width="3*" MinWidth="172"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧控制面板 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource ApplicationSecondaryBackgroundBrush}">
                <StackPanel Margin="4,2">

                    <!-- 1. 行情信息区 -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding UpdateTime}" FontSize="11"
                                           Foreground="{DynamicResource PriceTimeBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="涨跌幅" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="成交量" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Volume}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="持仓量" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding OpenInterest}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <!-- 空单/多单持仓（红底/蓝底） -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource ShortPositionBackgroundBrush}" CornerRadius="3" Padding="6,3" Margin="0,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="空单" FontSize="9" Foreground="{DynamicResource ShortPositionTextBrush}"/>
                                        <TextBlock Text="{Binding ShortPosition}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource LongPositionBackgroundBrush}" CornerRadius="3" Padding="6,3" Margin="2,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="多单" FontSize="9" Foreground="#AAAAFF"/>
                                        <TextBlock Text="{Binding LongPosition}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- 2. 挂单数量 -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="挂单数量" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="左键" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:NumberBox Grid.Column="1" Value="{Binding ValLeft, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="LeftOrderQuantity"
                                              ClearButtonEnabled="False" FontSize="12" Minimum="0"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="右键" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:NumberBox Grid.Column="1" Value="{Binding ValRight, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="RightOrderQuantity"
                                              ClearButtonEnabled="False" FontSize="12" Minimum="0"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- 价格梯密度：窗口级 RowHeight，关闭窗口时回写 Users.xml。 -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="价格梯格高" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="每侧 20 格" FontSize="9"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          AutomationProperties.AutomationId="PriceRowHeightStep"
                                          Value="{Binding RowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="10" Maximum="32" SmallChange="1"
                                          SpinButtonPlacementMode="Compact"
                                          ClearButtonEnabled="False"
                                          FontSize="11"
                                          ToolTip="调整每个价格格子的高度（10–32 像素）"/>
                        </Grid>
                    </ui:Card>

                    <!-- 3. 挂单模式 A/B -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="挂单模式" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <RadioButton Content="ChgOrder(A)" IsChecked="{Binding IsChgOrderA, Mode=TwoWay}"
                                             FontSize="11" Margin="0,1,8,1"
                                             ToolTip="A：撤同方向活动单后替换"/>
                                <RadioButton Content="ChgOrder(B)" IsChecked="{Binding IsChgOrderB, Mode=TwoWay}"
                                             FontSize="11" Margin="0,1"
                                             ToolTip="B：保留同方向活动单并追加"/>
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 4. 下单限制 -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="下单限制" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <CheckBox Content="Chg Nearby" IsChecked="{Binding CbNearby}" FontSize="11" Margin="0,2"/>
                            <CheckBox Content="CntrbySprd" IsChecked="{Binding CbCntrbySprd}" FontSize="11" Margin="0,2"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- 5. 价差锁定 -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="价差锁定" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="合约" Width="34" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ui:TextBox Grid.Row="0" Grid.Column="1"
                                            AutomationProperties.AutomationId="CounterpartySpreadInstrument"
                                            Text="{Binding CntrbySprdId, Mode=TwoWay}"
                                            PlaceholderText="对手合约代码" FontSize="11" Margin="4,0,0,2"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            ToolTip="价差锁定使用的对手合约代码"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pt" Width="34" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="1"
                                              AutomationProperties.AutomationId="CounterpartySpreadPoint"
                                              Value="{Binding CntrbySprdPt, Mode=TwoWay}"
                                              ClearButtonEnabled="False" FontSize="11" Margin="4,0,0,2" Minimum="0"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              ToolTip="价差点数"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fctr" Width="34" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ui:NumberBox Grid.Row="2" Grid.Column="1"
                                              AutomationProperties.AutomationId="CounterpartySpreadFactor"
                                              Value="{Binding CntrbySprdFctn, Mode=TwoWay}"
                                              ClearButtonEnabled="False" FontSize="11" Margin="4,0,0,0" Minimum="1"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              ToolTip="价差比例系数"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- 6. 开平仓 / M-OrderX -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="交易模式" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <CheckBox IsChecked="{Binding CbOnlyOpen}" FontSize="11" Margin="0,2">
                                <TextBlock Text="OnlyOpen（开仓）" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CbOc}"
                                      Visibility="{Binding IsCbOcConfigurationPersisted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      FontSize="11" Margin="0,2"
                                      ToolTip="旧版 CBOC。旧 XML 仅在 RunMode 1/2 保存；B 平仓时取消勾选会先请求撤销同方向开仓单。">
                                <TextBlock Text="B 平仓保留同向开仓单（RunMode 1/2）" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding MOrderX}" FontSize="11" Margin="0,2"
                                      Foreground="{DynamicResource WarningTextBrush}">
                                <TextBlock Text="M-OrderX（禁用）" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </ui:Card>

                    <!-- 7. 其他开关 -->
                    <ui:Card Margin="0,0,0,4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="辅助开关" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <CheckBox Content="涨跌停锁" IsChecked="{Binding CbZdtLock}" FontSize="11" Margin="0,2"/>
                            <CheckBox Content="白格单锁" IsChecked="{Binding CbBgds}" FontSize="11" Margin="0,2"/>
                            <CheckBox Content="成交标识" IsChecked="{Binding ShowTradeMark}" FontSize="11" Margin="0,2"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- 8. 底部状态区 -->
                    <ui:Card Margin="0,0,0,2" Padding="6,4" Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="撤单 "/><Run Text="{Binding CancelCount, Mode=OneWay}" TextDecorations="None"/><Run Text="K"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="C:"/><Run Text="{Binding TradeOpenCount, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="T:"/><Run Text="{Binding TradeCloseCount, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="持仓 " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalPosition}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OpenCloseMark}"
                                           FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧价格梯：固定保留交互状态栏，让提交/拒绝/成交不再静默。 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>
                <controls:PriceListControl x:Name="ContractPriceList" Grid.Row="0"
                                           PriceLadder="{Binding PriceLadder}"
                                           RowHeight="{Binding RowHeight, Mode=OneWay}"
                                           ShowWhiteGrid="{Binding ShowWhiteGrid, Mode=OneWay}"
                                           MouseWheelSpeed="3"
                                           PriceSelected="OnPriceLeftClicked"
                                           PriceRightClicked="OnPriceRightClicked"
                                           PendingOrderCancel="OnPendingOrderCancelClicked"/>
                <Border Grid.Row="1"
                        Background="{DynamicResource ApplicationSecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="5,2">
                    <Grid>
                        <TextBlock Text="左/右键点交易列 1/2 下单"
                                   AutomationProperties.AutomationId="PriceInteractionHint"
                                   FontSize="9" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Order.StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="PriceInteractionStatus"
                                   Text="{Binding Order.StatusMessage}"
                                   FontSize="9" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Order.StatusMessage}"
                                   Background="{DynamicResource ApplicationSecondaryBackgroundBrush}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
