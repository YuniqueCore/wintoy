<Window x:Class="FuturesTrader.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FuturesTrader.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FuturesTrader - 配置编辑（M1 示例）" Height="640" Width="520">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部按钮栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="加载" Command="{Binding LoadCommand}" Margin="0,0,8,0" Padding="14,4"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Padding="14,4"/>
            <TextBlock Text="{Binding LastSavedAt, StringFormat='已保存 {0:HH:mm:ss}'}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Window 段编辑表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Window 配置" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="主字体 MainFont" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Window.MainFont, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Text="紧凑度 CompactSpacing" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Window.CompactSpacing}" Margin="0,2"/>

                    <TextBlock Grid.Row="2" Text="字号偏移 FontSizeOffset" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Window.FontSizeOffset}" Margin="0,2"/>

                    <TextBlock Grid.Row="3" Text="价格边距 PriceListMargin" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Window.PriceListMargin}" Margin="0,2"/>

                    <TextBlock Grid.Row="4" Text="标题栏减高 DecTitle" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Window.DecTitle}" Margin="0,2"/>

                    <TextBlock Grid.Row="5" Text="对齐 Align" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Window.Align}" Margin="0,2"/>

                    <TextBlock Grid.Row="6" Text="窄模式减宽 NarrowReduceLength" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Window.NarrowReduceLength}" Margin="0,2"/>

                    <TextBlock Grid.Row="7" Text="滚轮加速 MouseWheelSpeed" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Window.MouseWheelSpeed}" Margin="0,2"/>

                    <TextBlock Grid.Row="8" Text="自动大小 AutoSize" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding Window.AutoSize}" Margin="0,4"/>

                    <TextBlock Grid.Row="9" Text="Tick 行高 TickRowHeights" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Window.TickRowHeights}" Margin="0,2"/>

                    <TextBlock Grid.Row="10" Text="合约窗口高度 InstrumentWindowHeights" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Window.InstrumentWindowHeights}" Margin="0,2"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏：ContentControl 按 State 运行时类型自动选 DataTemplate（零 Converter） -->
        <ContentControl Grid.Row="2" Content="{Binding State}" Margin="0,8,0,0">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:ConfigEditorState+Idle}">
                    <TextBlock Text="未加载" Foreground="Gray"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ConfigEditorState+Loading}">
                    <TextBlock Text="正在加载..." Foreground="SteelBlue"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ConfigEditorState+Loaded}">
                    <TextBlock Text="已加载" Foreground="Green"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ConfigEditorState+Saving}">
                    <TextBlock Text="正在保存..." Foreground="SteelBlue"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ConfigEditorState+Error}">
                    <Border Background="#FFF6E0E0" Padding="8">
                        <TextBlock Text="{Binding Message}" Foreground="DarkRed" TextWrapping="Wrap"/>
                    </Border>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
